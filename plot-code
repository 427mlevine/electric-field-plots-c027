import numpy as np
import matplotlib.pyplot as plt

k = 8.99e9
N = 20

# (q, x, y) for each charge
charges = [
    # 2
    (1, -8,  6), (1, -6,  6), (1, -4,  6), (1, -2,  6),   # top
    (1, -2,  4), (1, -2,  2),                             # upper right
    (1, -2,  0), (1, -4,  0), (1, -6,  0), (1, -8,  0),   # middle
    (1, -8, -2), (1, -8, -4),                             # lower left
    (1, -8, -6), (1, -6, -6), (1, -4, -6), (1, -2, -6),   # bottom

    # 7
    (1,  2,  6), (1,  4,  6), (1,  6,  6), (1,  8,  6),   # top
    (1,  7,  4), (1,  6,  2), (1,  5,  0),                # diagonal
    (1,  4, -2), (1,  3, -4), (1,  2, -6),
]

x = np.linspace(-10.0, 10.0, N)
y = np.linspace(-10.0, 10.0, N)
X, Y = np.meshgrid(x, y)

# now find field (superposition)
Ex = np.zeros_like(X)
Ey = np.zeros_like(Y)
for q, x0, y0 in charges:
    dx = X - x0
    dy = Y - y0
    thE = np.arctan2(dy, dx)
    magE = k*q / (dx**2 + dy**2)
    Ex += magE*np.cos(thE)
    Ey += magE*np.sin(thE)

Etot = np.sqrt(Ex**2 + Ey**2)

# quiver plot, uniform arrows
fig, ax = plt.subplots()
ax.quiver(X, Y, Ex/Etot, Ey/Etot)
for q, x0, y0 in charges:
    ax.plot(x0, y0, 'ko', markersize=8)
ax.set_aspect('equal')
ax.set_xlabel('x')
ax.set_ylabel('y')
plt.show()
